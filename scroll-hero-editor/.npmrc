# @theatre/r3f 0.7.2 declares a peer of @react-three/fiber ^8, and this project is on ^9.
# The pairing works in practice — Theatre's r3f binding drives the Studio overlay only —
# but npm's strict peer resolution refuses to install it. The dependency tree was already
# built this way; writing it down means a fresh clone and CI behave like this checkout.
legacy-peer-deps=true
